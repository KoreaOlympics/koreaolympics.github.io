    <div class="layout-wrapper">
        <div class="waf-head">
            <div data-organism="head-01" class="head-wrap">
                <h3 class="title" data-atom="title-01">Following</h3>
            </div>
        </div>
        <div class="waf-body">
            <div class="waf-body-content">
<!-- SnapWidget -->
<script src="https://snapwidget.com/js/snapwidget.js"></script>
<iframe src="https://snapwidget.com/embed/1112556" class="snapwidget-widget" allowtransparency="true" frameborder="0" scrolling="no" style="border:none; overflow:hidden;  width:100%; " title="Posts from Instagram"></iframe>
            </div>
        </div>
    </div>
</div></div></section></div></div></div></div></section><section class="waf-row"><div class="waf-view"><div class="container-fluid"><div class="row sticky-container"><div class="col-lg-12"><section data-mobile="widget_layout_01" data-template="widget_layout_01" data-component="SI-ads" data-tooltip="SI-ads / widget_layout_01" id="07023538-0fae-4faf-87ec-38ef783d4ef0" data-title="SI-widget_layout_01/widget_layout_01" class="site-content"><div data-section-id="07023538-0fae-4faf-87ec-38ef783d4ef0"><div class="waf-component waf-form-guest" v-cloak>
  <div class="layout-wrapper">
      <div class="waf-head">
          <div class="head-wrap">
              <h3 class="title">become a <span class="highlight">gsoc</span> house guest</h3>
          </div>
      </div>
      <div class="waf-body">
<span class="consent-title" style="text-transform: none;">Don't miss a single highlight, hot take, or behind-the-scenes moment - subscribe to the GSOC newsletter! Get exclusive news and exclusive promos delivered straight to your inbox.</span>
          <form action="" method="post" class="form-contact">
              <div class="form-element" :class="{'error':checkName}">
                  <span class="form-label">First name</span>
                  <input type="text" class="form-input" placeholder="First Name" name="fname" v-model="name" @input=nameValidation>
                  <span class="errordiv">{{errNameMessage}}</span>
                  <!-- <span class="errordiv">Error message here</span> -->
                  <!-- <span class="successdiv">Success Message here</span> -->
                  <!-- <span class="infodiv">Info messagfe here</span> -->
              </div>
              <div class="form-element" :class="{'error':checkLastName}">
                  <span class="form-label">Last name</span>
                  <input type="text" class="form-input" placeholder="Last Name" name="lname"  v-model="lastName" @input=lastNameValidation>
                  <span class="errordiv">{{errLastNameMessage}}</span>
                  <!-- <span class="errordiv">Error message here</span> -->
                  <!-- <span class="successdiv">Success Message here</span> -->
                  <!-- <span class="infodiv">Info messagfe here</span> -->
              </div>
              <div class="form-element email" :class="{'error':checkEmail}">
                  <span class="form-label">Email Address</span>
                  <input type="email" class="form-input" placeholder="Email" name="email" v-model="email" @input=emailValidation>
                  <span class="errordiv">{{errEmailMessage}}</span>
                  <!-- <span class="errordiv">Error message here</span> -->
                  <!-- <span class="successdiv">Success Message here</span> -->
                  <!-- <span class="infodiv">Info message here</span> -->
              </div>
              <div class="consent-wrap">
                  <span class="consent-title">subscription consent</span>
                  <div class="consent-element">
                      <input type="checkbox" v-model="consent" id="consent" name="consent" value="consent">
                      <label  for="consent">I agree to the <a class="privacy-policy" href="/privacy-policy">privacy policy</a></label>
                  </div>
                  <span class="errordiv">{{errConsentMessage}}</span>

                  <!-- <div class="captcha-box"> -->
                      <!--Render Captcha here -->
                  <!-- </div> -->
              </div>
              <div class="form-element form-submit">
                <button
                  type="submit"
                  class="btn-submit"
                  aria-expanded="false"
                  aria-label="Submit"
                  @click.prevent="submitForm()"
                >
                  <span class="btn-text">Subscribe</span>
                </button>
              </div>
              <div class="success-box" v-if="formSubmitted">
                  <span class="text">Thank you for subscribing to our Newsletter!</span>
              </div>
          </form>
      </div>
  </div>
</div></div></section></div></div></div></div></section></section></main> <footer class="footer-wrap"><section id="27c261d6-954f-4781-ba32-277f11ae8477" data-component="si-ads" data-template="widget_layout_01" class="footer-top-section"><div data-section-id="27c261d6-954f-4781-ba32-277f11ae8477"><div class="footer-section-wrap">
